# Optional Citadel image with code-server for the experimental browser IDE.
# Keep the default sandbox/agent images lean; build this when you want GUI access:
#
#   docker build -f deploy/Dockerfile.ide -t runeward-ide:latest .
#
# Charter: examples/ide-demo.toml  (+ RUNEWARD_ENABLE_EXPERIMENTAL_IDE=1 on serve)
#
# PID 1 stays `sleep infinity` so the control plane can Exec-start code-server
# after create (same pattern as other long-lived in-cell helpers).
FROM codercom/code-server:4.96.4

USER root
RUN mkdir -p /workspace \
    && chown -R coder:coder /workspace

USER coder
ENV HOME=/home/coder
WORKDIR /workspace
ENTRYPOINT []
CMD ["sleep", "infinity"]
