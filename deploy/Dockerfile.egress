# runeward egress proxy: init container (--setup-iptables) and sidecar.
FROM --platform=$BUILDPLATFORM golang:1.26.6@sha256:0d1d3a794be25f809dd2cb3160d8c73276c4056a9f8242a138e908ddeee7b6b6 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
ARG TARGETOS
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /out/runeward-egress ./cmd/runeward-egress

# A small Alpine runtime provides iptables without Debian's otherwise-unused
# Perl runtime, reducing both the attack surface and unfixed package CVEs.
FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
RUN apk add --no-cache iptables ca-certificates
RUN adduser -S -D -H -u 10001 -G root egress
COPY --from=build /out/runeward-egress /usr/local/bin/runeward-egress
USER 10001
ENTRYPOINT ["/usr/local/bin/runeward-egress"]
CMD ["--addr", ":8888", "--policy", "/etc/runeward/policy.json"]
